#!/usr/bin/env bash
set -euo pipefail

command -v ya >/dev/null 2>&1 || exit 0

PACKAGES=(
{{- range .yazi_packages }}
  {{ . | quote }}
{{- end }}
)

pkg_file="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/package.toml"
installed=()

if [[ -f "$pkg_file" ]]; then
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] && installed+=("$pkg")
  done < <(sed -nE 's/^[[:space:]]*use[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$pkg_file")
fi

is_listed() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Remove plugins and flavors no longer present in yazi_packages
for pkg in ${installed[@]+"${installed[@]}"}; do
  if ! is_listed "$pkg" ${PACKAGES[@]+"${PACKAGES[@]}"}; then
    ya pkg delete "$pkg"
  fi
done

# Install missing plugins and flavors
for pkg in ${PACKAGES[@]+"${PACKAGES[@]}"}; do
  if ! is_listed "$pkg" ${installed[@]+"${installed[@]}"}; then
    ya pkg add "$pkg"
  fi
done
