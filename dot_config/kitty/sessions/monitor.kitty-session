new_tab System Managment
#Monitoring terminal setup
layout tall
#Launch cpu monitoring
launch sh -c "sleep 0.3 && btop -p 1"
#Launch gpu monitoring
launch sh -c "sleep 0.3 && nvtop"
#Launch memory monitoring
launch sh -c "sleep 0.3 && btop -p 2"
#Launch net monitoring
launch sh -c "sleep 0.3 && btop -p 4"

#Process managment tab
new_tab Process Managment
layout tall
launch sh -c "sleep 0.3 && btop -p 3"
launch sh -c "sleep 0.3 && btop -p 2"
launch sh -c "sleep 0.3 && btop -p 1"

#File managment setup
new_tab Disk Cleanup
launch sh -c "sleep 0.3 && ncdu /"
