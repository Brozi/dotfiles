// Catppuccin Mocha

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": {
      "1": "#CBA6F7",
      "2": "#f5c2e7",
    },
    "source": "",
    "width": null,
    "height": null,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4,
    },
  },
  "display": {
    "separator": " \u001b[38;2;203;166;247m\u001b[0m ",
    "constants": [
      "\u001b[38;2;242;205;205m─────────────────\u001b[0m", // {$1}, used in Custom module
    ],
    "key": {
      "type": "string",
      "paddingLeft": 2,
    },
    "size": {
      "binaryPrefix": "iec",
    },
  },
  "modules": [
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 10,
    },
    "break",
    // {
    //   "type": "host",
    //   "keyColor": "#f5c2e7",
    //   "key": "󰒋",
    // },
    {
      "type": "cpu",
      "keyColor": "#f5c2e7",
      "key": "",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "keyColor": "#f5c2e7",
      "key": "󰢮",
      "driverSpecific": true,
      "format": "{name} ({dedicated-total})",
    },
    {
      "type": "memory",
      "keyColor": "#f5c2e7",
      "key": "",
      "format": "{total}",
    },
    {
      "type": "os",
      "keyColor": "#f5c2e7",
      "key": "",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "keyColor": "#f5c2e7",
      "key": "",
      "format": "{release}",
    },
    {
      "type": "lm",
      "keyColor": "#f5c2e7",
      "key": "󰨇",
      "format": "{service} {version}",
    },
    {
      "type": "de",
      "keyColor": "#f5c2e7",
    },
    {
      "type": "wm",
      "keyColor": "#f5c2e7",
      "key": "",
      "format": "{pretty-name} {version}",
    },
    {
      "type": "theme",
      "keyColor": "#f5c2e7",
      "key": "󰉼",
      "format": "{theme2}",
    },
    {
      "type": "icons",
      "key": "",
      "keyColor": "#f5c2e7",
    },
    {
      "type": "packages",
      "keyColor": "#f5c2e7",
      "key": "󰏖",
      "format": "{all} ({appimage} appimg, {flatpak-all} flatpak)",
    },
    {
      "type": "uptime",
      "keyColor": "#f5c2e7",
      "key": "",
      // display the amount of days, hours and minutes only when the number is greater than 0.
      "format": "{?days}{days}d {hours}h {minutes}m {?}{/days}{?hours}{hours}h {?}{minutes}m{/}",
    },
    {
      "type": "command",
      "keyColor": "#f5c2e7",
      "key": "",
      "text": "~/.config/fastfetch/scripts/age.sh",
    },
    {
      "type": "command",
      "key": "",
      "keyColor": "#f5c2e7",
      "text": "~/.config/fastfetch/scripts/last-win-boot",
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "#f5c2e7",
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "#f5c2e7",
    },
    {
      "type": "terminalfont",
      "key": "",
      "keyColor": "#f5c2e7",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 10,
    },
  ],
}
