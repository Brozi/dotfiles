#!/usr/bin/env bash
active_is_figma=0

xprop -spy -root _NET_ACTIVE_WINDOW | while read -r line; do
  win_id=$(echo "$line" | awk '{print $NF}')
  [[ "$win_id" == "0x0" || -z "$win_id" ]] && continue

  wm_class=$(xprop -id "$win_id" WM_CLASS 2>/dev/null)
  if [[ "$wm_class" == *"figma-desktop"* || "$wm_class" == *"Figma-desktop"* ]]; then
    if [[ $active_is_figma -eq 0 ]]; then
      keyd.rvaiya bind "rightalt = layer(polish_altgr)" "leftshift = layer(figma_shift)" "rightshift = layer(figma_shift)"
      active_is_figma=1
    fi
  else
    if [[ $active_is_figma -eq 1 ]]; then
      keyd.rvaiya bind reset
      active_is_figma=0
    fi
  fi
done
