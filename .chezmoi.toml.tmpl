{{- $email := promptStringOnce . "email" "What is your git email address" -}}
{{- $role := promptStringOnce . "role" "Machine role (desktop or server)" -}}

[data]
    email = {{ $email | quote }}
    role = {{ $role | quote }}

[merge]
    command = "nvim"
    args = [
        "-d", 
        "{{ "{{" }} .Destination {{ "}}" }}", 
        "{{ "{{" }} .Source {{ "}}" }}", 
        "{{ "{{" }} .Target {{ "}}" }}"
    ]
[git]
    autoAdd = true
    autoCommit = true
    autoPush = true
